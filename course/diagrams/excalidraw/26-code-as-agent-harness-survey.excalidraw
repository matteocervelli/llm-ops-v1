    {"type":"text","id":"op1t","x":48,"y":1132,"width":202,"height":114,"text":"ORACLE ADEQUACY\nEval beyond pass/fail\n\nTest verdi ≠ corretto.\nNeed: coverage, diversity,\nformal specs, semantic checks","originalText":"ORACLE ADEQUACY\nEval beyond pass/fail\n\nTest verdi ≠ corretto.\nNeed: coverage, diversity,\nformal specs, semantic checks","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#D14D41","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14005,"version":1,"versionNonce":14006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"op2","x":274,"y":1124,"width":218,"height":130,"strokeColor":"#D14D41","backgroundColor":"#FFEBEE","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14007,"version":1,"versionNonce":14008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"op2t","x":282,"y":1132,"width":202,"height":114,"text":"SEMANTIC VERIFICATION\nOltre executable feedback\n\nExec è necessario ma non\nsufficiente. Serve stack\nmulti-layer: test+lint+\nHITL+spec formali","originalText":"SEMANTIC VERIFICATION\nOltre executable feedback\n\nExec è necessario ma non\nsufficiente. Serve stack\nmulti-layer: test+lint+\nHITL+spec formali","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#D14D41","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14009,"version":1,"versionNonce":14010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"op3","x":508,"y":1124,"width":218,"height":130,"strokeColor":"#D14D41","backgroundColor":"#FFEBEE","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14011,"version":1,"versionNonce":14012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"op3t","x":516,"y":1132,"width":202,"height":114,"text":"SELF-EVOLVING HARNESS\nSenza regression\n\nOgni modifica = rischio.\nNeed: change contract,\nregression suites, rollback,\ncanary deploy","originalText":"SELF-EVOLVING HARNESS\nSenza regression\n\nOgni modifica = rischio.\nNeed: change contract,\nregression suites, rollback,\ncanary deploy","fontSize":14,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#D14D41","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14013,"version":1,"versionNonce":14014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
