    {"type":"rectangle","id":"b3r4h","x":1026,"y":808,"width":400,"height":30,"strokeColor":"#D14D41","backgroundColor":"#D14D41","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":13021,"version":1,"versionNonce":13022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"b3r4ht","x":1034,"y":812,"width":384,"height":22,"text":"GAP PRINCIPALE","originalText":"GAP PRINCIPALE","fontSize":15,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#FFFFFF","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":13023,"version":1,"versionNonce":13024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"b3r4t","x":1034,"y":846,"width":384,"height":204,"text":"Shared State:\nimplicit/file → repository\n→ execution-based → blackboard\n\nLa maggioranza dei sistemi\nusa implicit/file state →\ngli agenti non possono rilevare\ndivergenza dallo stato reale.\n\nConvergenza:\ntest-gated  ·  security\nperformance  ·  score-based\nconsensus  ·  implicit (comune)\n\n⚠ La maggioranza usa\nimplicit convergence\n= nessun criterio oggettivo","originalText":"Shared State:\nimplicit/file → repository\n→ execution-based → blackboard\n\nLa maggioranza dei sistemi\nusa implicit/file state →\ngli agenti non possono rilevare\ndivergenza dallo stato reale.\n\nConvergenza:\ntest-gated  ·  security\nperformance  ·  score-based\nconsensus  ·  implicit (comune)\n\n⚠ La maggioranza usa\nimplicit convergence\n= nessun criterio oggettivo","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#D14D41","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":13025,"version":1,"versionNonce":13026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"op0","x":40,"y":1086,"width":1400,"height":30,"text":"OPEN PROBLEMS — 6 sfide aperte per costruire harness affidabili","originalText":"OPEN PROBLEMS — 6 sfide aperte per costruire harness affidabili","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1B2631","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":14001,"version":1,"versionNonce":14002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
