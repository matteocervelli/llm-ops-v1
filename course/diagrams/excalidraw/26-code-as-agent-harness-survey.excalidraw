    {"type":"text","id":"b1c1ht","x":60,"y":140,"width":412,"height":22,"text":"CODE FOR REASONING","originalText":"CODE FOR REASONING","fontSize":16,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#FFFFFF","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":11011,"version":1,"versionNonce":11012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"b1c1t","x":60,"y":178,"width":412,"height":158,"text":"Il modello genera programmi eseguibili\nche un runtime esterno verifica.\nRagionamento = calcolo delegato al codice.\n\nEsempi: PAL · PoT · Chain of Code\nLean theorem provers · CodePRM\n\nParadigmi:\n· Delegated: interprete esegue\n· Formal: proof assistant verifica\n· Iterative: exec feedback refina","originalText":"Il modello genera programmi eseguibili\nche un runtime esterno verifica.\nRagionamento = calcolo delegato al codice.\n\nEsempi: PAL · PoT · Chain of Code\nLean theorem provers · CodePRM\n\nParadigmi:\n· Delegated: interprete esegue\n· Formal: proof assistant verifica\n· Iterative: exec feedback refina","fontSize":14,"fontFamily":1,"textAlign":"left","verticalAlign":"top","strokeColor":"#1B2631","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":11013,"version":1,"versionNonce":11014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

